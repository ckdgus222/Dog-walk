generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  nickname         String   @unique
  refreshTokenHash String?  @map("refresh_token_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  dogs             Dog[]
  chatMessages     ChatMessage[]
  sentWalkRequests WalkRequest[] @relation("SentWalkRequests")
  receivedWalkRequests WalkRequest[] @relation("ReceivedWalkRequests")
  location         Unsupported("geography(Point, 4326)")?
  locationConsentedAt DateTime? @map("location_consented_at") @db.Timestamptz(3)
  locationUpdatedAt DateTime? @map("location_updated_at") @db.Timestamptz(3)

  @@index([location(ops: raw("gist_geography_ops"))], type: Gist)
  @@map("users")
}

model Dog {
  id          Int       @id @default(autoincrement())
  ownerId     Int       @map("owner_id")
  owner       User      @relation(fields: [ownerId], references: [id])
  name        String
  breed       String
  size        DogSize
  gender      DogGender
  neutered    Boolean
  birthYear   Int       @map("birth_year")
  personality String
  photoUrl    String?   @map("photo_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerId])
  @@map("dogs")
}

enum DogSize {
  SMALL
  MEDIUM
  LARGE
}

enum DogGender {
  MALE
  FEMALE
}

model WalkRequest {
  id          Int               @id @default(autoincrement())
  requesterId Int               @map("requester_id")
  receiverId  Int               @map("receiver_id")
  requester   User              @relation("SentWalkRequests", fields: [requesterId], references: [id])
  receiver    User              @relation("ReceivedWalkRequests", fields: [receiverId], references: [id])
  status      WalkRequestStatus @default(PENDING)
  message     String?           @db.VarChar(100)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  respondedAt DateTime?         @map("responded_at") @db.Timestamptz(3)
  chatMessages ChatMessage[]

  // The pending pair expression index is maintained in migration SQL.
  @@index([receiverId, status])
  @@index([requesterId, status])
  @@map("walk_requests")
}

enum WalkRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

model ChatMessage {
  id            Int         @id @default(autoincrement())
  walkRequestId Int         @map("walk_request_id")
  senderId      Int         @map("sender_id")
  walkRequest   WalkRequest @relation(fields: [walkRequestId], references: [id])
  sender        User        @relation(fields: [senderId], references: [id])
  content       String      @db.VarChar(500)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([walkRequestId, createdAt])
  @@map("chat_messages")
}
