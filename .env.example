# Compose only. These are fake credentials for local development.
POSTGRES_USER=dogwalk
POSTGRES_PASSWORD=dogwalk_local_only
POSTGRES_DB=dogwalk
DATABASE_URL=postgresql://dogwalk:dogwalk_local_only@db:5432/dogwalk

# Fake placeholders: replace both secrets before use.
JWT_ACCESS_SECRET=replace-with-your-access-secret
JWT_REFRESH_SECRET=replace-with-your-different-refresh-secret
# The HTTPS compose file below turns this on by itself.
COOKIE_SECURE=false

# Public JavaScript key. Replace with a key restricted to your site domains.
NEXT_PUBLIC_KAKAO_MAP_KEY=replace-with-your-kakao-javascript-key

# Only enable this when switching the server to HTTPS. It also sets COOKIE_SECURE=true.
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
